{\n  \"project\": {\n    \"name\": \"Manager.AI\",\n    \"team\": [\"Rohit\", \"Rajiv\", \"Jagan\"],\n    \"description\": \"Automated Weekly Status Report Generator for CRM Team\"\n  },\n  \"jira\": {\n    \"query_type\": \"sprint\",\n    \"sprint_id\": \"123\",\n    \"metric_preference\": \"story_points\",\n    \"custom_fields\": {\n      \"story_points\": \"customfield_10016\",\n      \"epic_link\": \"customfield_10014\"\n    },\n    \"status_mappings\": {\n      \"done\": [\"Done\", \"Resolved\", \"Closed\"],\n      \"in_progress\": [\"In Progress\", \"In Review\", \"Code Review\"],\n      \"to_do\": [\"To Do\", \"Backlog\", \"Open\"],\n      \"blocked\": [\"Blocked\", \"On Hold\", \"Impediment\"]\n    }\n  },\n  \"confluence\": {\n    \"space_key\": \"MNGRAI\",\n    \"page_title\": \"Weekly Status Reports\",\n    \"parent_page_id\": \"123456\"\n  },\n  \"report\": {\n    \"health_thresholds\": {\n      \"green_max\": 10,\n      \"yellow_max\": 25\n    },\n    \"timezone\": \"America/New_York\"\n  }\n}\n"