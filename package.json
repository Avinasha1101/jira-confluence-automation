{\n  \"name\": \"manager-ai-weekly-report\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Automated Weekly Status Report Generator for Manager.AI\",\n  \"main\": \"dist/index.js\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"start\": \"node dist/index.js\",\n    \"dev\": \"ts-node src/index.ts\",\n    \"test\": \"jest\",\n    \"test:watch\": \"jest --watch\",\n    \"test:coverage\": \"jest --coverage\",\n    \"lint\": \"eslint src tests\",\n    \"format\": \"prettier --write \\\"src/**/*.ts\\\" \\\"tests/**/*.ts\\\"\"\n  },\n  \"keywords\": [\n    \"jira\",\n    \"confluence\",\n    \"automation\",\n    \"reporting\",\n    \"status-reports\"\n  ],\n  \"author\": \"Manager.AI Team\",\n  \"license\": \"MIT\",\n  \"dependencies\": {\n    \"axios\": \"^1.6.0\",\n    \"luxon\": \"^3.4.0\",\n    \"marked\": \"^11.0.0\",\n    \"commander\": \"^11.0.0\",\n    \"express\": \"^4.18.0\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^20.0.0\",\n    \"@types/jest\": \"^29.5.0\",\n    \"@types/express\": \"^4.17.0\",\n    \"jest\": \"^29.7.0\",\n    \"ts-jest\": \"^29.1.0\",\n    \"typescript\": \"^5.3.0\",\n    \"eslint\": \"^8.50.0\",\n    \"@typescript-eslint/eslint-plugin\": \"^6.7.0\",\n    \"@typescript-eslint/parser\": \"^6.7.0\",\n    \"prettier\": \"^3.0.0\",\n    \"ts-node\": \"^10.9.0\"\n  },\n  \"jest\": {\n    \"preset\": \"ts-jest\",\n    \"testEnvironment\": \"node\",\n    \"collectCoverageFrom\": [\n      \"src/**/*.ts\",\n      \"!src/**/*.d.ts\",\n      \"!src/index.ts\"\n    ],\n    \"coverageThreshold\": {\n      \"global\": {\n        \"branches\": 80,\n        \"functions\": 80,\n        \"lines\": 80,\n        \"statements\": 80\n      }\n    }\n  }\n}\n"